# Set only after the production domain is approved.
NEXT_PUBLIC_SITE_URL=https://voting-pgsd.example.id

# Required serverless PostgreSQL URL. In Vercel, use a Neon/Postgres integration
# and save this separately for Development, Preview, and Production.
DATABASE_URL=

# Required before enabling NIM verification and voting APIs. Use random values
# of at least 32 characters, and never commit the real `.env.local` file.
VOTING_TOKEN_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
